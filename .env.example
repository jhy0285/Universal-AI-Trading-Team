# One global provider/model for CHIEF, SCAN, VET and BOOK.
# CLI profiles use existing login or native environment authentication.
# codex_cli / claude_cli / gemini_cli / qwen_cli / opencode_cli / copilot_cli
# goose_cli / ollama_cli / custom_cli; HTTP providers are also supported.
# llama_cpp: checksum-verified, loopback-only CPU model, no API key needed.
LLM_PROVIDER=codex_cli
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=
# Local mode expects a working local codex login and writable normal CLI state.
CODEX_RUNNER=local
# Optional override of the one selected CLI executable.
LLM_CLI_EXECUTABLE=
# custom_cli only: JSON argv array. Credentials must stay in the environment.
LLM_CLI_COMMAND=[]
LLM_CLI_INPUT=json
LLM_CLI_OUTPUT=bridge_json
LLM_CLI_API_KEY_ENV=
# Optional backend for Goose, configured globally.
LLM_CLI_BACKEND=
TRADING_MODE=paper
# Virtual USD for a newly created main ledger. An existing ledger keeps its balance and history.
PAPER_INITIAL_CASH=1000
DATABASE_URL=sqlite:///.state/trading.sqlite3
WORLDMONITOR_BASE_URL=http://127.0.0.1:3000
# Required for mutating HTTP API calls. Generate locally; never commit the value.
API_ADMIN_TOKEN=
# Autonomous paper operation. A missing observation still blocks its trade.
AUTONOMOUS_ENABLED=false
AUTONOMOUS_COLLECT_SECONDS=60
AUTONOMOUS_PROBE_RETRY_SECONDS=3600
# llama_cpp model artifact selection. Model identity remains the global LLM_MODEL.
LOCAL_LLM_MODEL_URL=
LOCAL_LLM_MODEL_SHA256=
LOCAL_LLM_THREADS=4
LOCAL_LLM_CONTEXT_SIZE=8192
# Optional verified observations, restricted to Dex-discovered asset/pool IDs.
MARKET_DATA_FEED_URL=
MARKET_DATA_FEED_API_KEY=
# Local Redis/seed runtime. setup_worldmonitor_runtime.py generates the private token.
WORLDMONITOR_SEED_ENABLED=false
WORLDMONITOR_REDIS_TOKEN=
